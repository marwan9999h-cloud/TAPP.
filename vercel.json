{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/((?!assets/|og/|favicon\\.ico|favicon\\.svg|favicon-96x96\\.png|apple-touch-icon\\.png|robots\\.txt|sitemap\\.xml).*)",
      "destination": "/index.html"
    }
  ]
}
